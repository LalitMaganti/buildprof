#!/usr/bin/env bash
# Upload example recordings to the `examples` GitHub release, from which the
# deploy job copies them to https://buildprof.lalitm.com/examples/.
#
# Usage: publish-examples <name>.buildprof [...]
#
# The file name is what the CLI and the homepage refer to (see EXAMPLES in
# src/args.rs and the homepage overlay). Record examples with a released
# Buildprof so they carry a version attribute and open in a matching UI.
set -euo pipefail

repository=${BUILDPROF_REPOSITORY:-LalitMaganti/buildprof}
tag=examples

if (( $# == 0 )); then
  echo "usage: $0 <name>.buildprof [...]" >&2
  exit 2
fi

for file in "$@"; do
  [[ -f "$file" ]] || { echo "missing: $file" >&2; exit 1; }
  [[ "$file" == *.buildprof ]] || { echo "not a .buildprof file: $file" >&2; exit 1; }
  if [[ "$(head -c 4 "$file" | xxd -p)" != "28b52ffd" ]]; then
    echo "$file is not a zstd stream; record it with Buildprof 0.2.0 or newer" >&2
    exit 1
  fi
  if (( $(stat -c %s "$file" 2>/dev/null || stat -f %z "$file") > 25 * 1024 * 1024 )); then
    echo "$file exceeds Cloudflare Pages' 25 MiB asset limit" >&2
    exit 1
  fi
done

if ! gh release view "$tag" --repo "$repository" >/dev/null 2>&1; then
  gh release create "$tag" --repo "$repository" --title "Example recordings" \
    --notes "Recordings served at https://buildprof.lalitm.com/examples/ and opened by \`buildprof open --example\`." \
    --prerelease
fi
gh release upload "$tag" --repo "$repository" --clobber "$@"
echo "uploaded; the next UI deploy publishes them"
