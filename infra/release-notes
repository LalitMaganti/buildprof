"""Reshape dist's generated release notes for the release page.

dist's body (changelog, install, download table with checksums) is kept in
that order. This adds a one-line description at the top, replaces the install
section with the README's commands, and uses smaller headings throughout. It
also joins the changelog's wrapped lines, because GitHub turns each line break
in a release body into a break on the page.

Usage: release-notes v0.2.2 < dist-notes.md > notes.md
"""
from __future__ import annotations

import re
import sys

TAGLINE = (
    "Buildprof records every process a build starts and every file it opens, "
    "and shows the whole build on an interactive timeline in your browser.\n"
)

INSTALL = """\
### Install

Recording requires Linux or macOS. Existing recordings can be viewed on any
platform in the web UI without installing Buildprof. Install on the machine
that runs your build using whichever method you prefer:

**Shell script**

```sh
curl -fsSL https://buildprof.lalitm.com/install.sh | sh
```

**Homebrew**

```sh
brew install lalitmaganti/tap/buildprof
```

**mise**

```sh
mise use -g github:LalitMaganti/buildprof
```
"""


# Lines that start a block of their own, and are never joined onto the line
# before them: headings, list items, tables, quotes, HTML, images and fences.
BLOCK_START = re.compile(r"^\s*(#|[-*+] |\d+\. |\||>|<|!\[|```)")


def unwrap(body: str) -> str:
    """Joins each paragraph or list item onto one line."""
    out: list[str] = []
    in_fence = False
    for line in body.split("\n"):
        if line.lstrip().startswith("```"):
            in_fence = not in_fence
            out.append(line)
            continue
        previous = out[-1] if out else ""
        if (
            not in_fence
            and line.strip()
            and not BLOCK_START.match(line)
            and previous.strip()
            and not re.match(r"^\s*(#|\||<|!\[|```)", previous)
            # A line ending in two spaces or a backslash asks for a break.
            and not previous.endswith(("  ", "\\"))
        ):
            out[-1] = previous.rstrip() + " " + line.strip()
        else:
            out.append(line)
    return "\n".join(out)


def main() -> int:
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    body = sys.stdin.read().replace("\r\n", "\n")

    # Demote every heading one level so the page reads as sections of the
    # release rather than a document of its own.
    body = re.sub(r"(?m)^(#{2,5}) ", lambda m: "#" + m.group(1) + " ", body)
    body = re.sub(r"(?m)^### Release Notes[ \t]*$", "### Changes", body)
    body = re.sub(r"(?m)^### Download \S+ [^\n]*$", "### Downloads", body)

    body, count = re.subn(
        r"(?ms)^### Install \S+ [^\n]*\n.*?(?=^### Downloads|\Z)",
        INSTALL + "\n",
        body,
        count=1,
    )
    if count != 1:
        sys.exit("no install section found in the release notes on stdin")

    sys.stdout.write(unwrap(TAGLINE + "\n" + body.lstrip("\n")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
