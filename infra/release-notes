#!/usr/bin/env python3
"""Reshape dist's generated release notes for the release page.

dist's body (changelog, install, download table with checksums) is kept in
that order. This adds a one-line description at the top, replaces the install
section with the README's commands, and uses smaller headings throughout.

Usage: release-notes v0.2.2 < dist-notes.md > notes.md
"""
from __future__ import annotations

import re
import sys

TAGLINE = (
    "Buildprof records every process a build starts and every file it opens, "
    "and shows the whole build on an interactive timeline in your browser. "
    "Nothing is ever uploaded.\n"
)

INSTALL = """\
### Install

Recording requires Linux; the macOS build only opens traces. Use whichever of
these you already have:

**Shell script**

```sh
curl -fsSL https://buildprof.lalitm.com/install.sh | sh
```

**Homebrew**

```sh
brew install lalitmaganti/tap/buildprof
```

**mise**

```sh
mise use -g github:LalitMaganti/buildprof
```
"""


def main() -> int:
    if len(sys.argv) != 2:
        sys.exit(__doc__)
    body = sys.stdin.read()

    # Demote every heading one level so the page reads as sections of the
    # release rather than a document of its own.
    body = re.sub(r"(?m)^(#{2,5}) ", lambda m: "#" + m.group(1) + " ", body)
    body = re.sub(r"(?m)^### Release Notes[ \t]*$", "### Changes", body)
    body = re.sub(r"(?m)^### Download \S+ [^\n]*$", "### Downloads", body)

    body, count = re.subn(
        r"(?ms)^### Install \S+ [^\n]*\n.*?(?=^### Downloads|\Z)",
        INSTALL + "\n",
        body,
        count=1,
    )
    if count != 1:
        sys.exit("no install section found in the release notes on stdin")

    sys.stdout.write(TAGLINE + "\n" + body.lstrip("\n"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
