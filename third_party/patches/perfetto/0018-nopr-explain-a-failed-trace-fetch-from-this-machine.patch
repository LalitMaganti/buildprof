+// Chrome asks before a public site may reach this machine. Once blocked, every
+// fetch fails with a bare "Failed to fetch", indistinguishable from nothing
+// listening, so ask the Permissions API which case this is where it can.
+async function localNetworkAccessDenied(): Promise<boolean> {
+  try {
+    const name = 'local-network-access' as PermissionName;
+    return (await navigator.permissions.query({name})).state === 'denied';
+  } catch {
+    return false;
+  }
+}
+
+async function showLocalTraceFetchError(url: string, details: string) {
+  const denied = await localNetworkAccessDenied();
+  const allowStep =
+    'Allow "Local network access" for this site in the site settings ' +
+    'next to the address bar.';
+  const retryStep = 'Run buildprof open <TRACE> again.';
+  const promptStep =
+    'If Chrome asks whether this site may access other apps and services ' +
+    'on this device, allow it.';
+  showModal({
+    title: denied
+      ? 'Chrome is blocking access to this machine'
+      : 'Could not fetch the trace from this machine',
+    content: () =>
+      m(
+        '.pf-error-dialog',
+        m(
+          Callout,
+          {icon: Icons.Warning, intent: Intent.Warning},
+          denied
+            ? 'This site was denied permission to access other apps and ' +
+                'services on this device, which is how the page fetches ' +
+                `the trace from ${url}.`
+            : `Nothing answered at ${url}. The buildprof command serving ` +
+                'the trace may have stopped waiting, or Chrome may be ' +
+                'blocking this site from reaching this machine.',
+        ),
+        m(
+          '.pf-error-dialog__note',
+          m(
+            'ol',
+            ...(denied
+              ? [m('li', allowStep), m('li', retryStep)]
+              : [m('li', retryStep), m('li', promptStep), m('li', allowStep)]),
+          ),
+        ),
+        m(CodeSnippet, {
+          text: details,
+          language: 'Error details',
+          class: 'pf-error-dialog__code',
+        }),
+      ),
+  });
+}
