diff --git a/ui/src/core/embedder/embedder.ts b/ui/src/core/embedder/embedder.ts
index 3fb965daa7..2dc9b8658c 100644
--- a/ui/src/core/embedder/embedder.ts
+++ b/ui/src/core/embedder/embedder.ts
@@ -75,4 +75,14 @@ export interface Embedder {
 
   // Optional deployment-owned sidebar wordmark replacing Perfetto's.
   readonly brandLogo?: {readonly src: string; readonly alt?: string};
+
+  // Optional compact navigation for focused deployments. Registered sidebar
+  // actions are shown in the top bar and the persistent sidebar is removed.
+  readonly navigationMode?: 'sidebar' | 'topbar';
+
+  // Optional deployment-specific sidebar customization.
+  readonly documentationUrl?: string;
+  readonly reportBugUrl?: string;
+  readonly showConvertToJson?: boolean;
+  readonly showMetatrace?: boolean;
