@@ -25,6 +25,7 @@ import {Button} from '../widgets/button';
 import {Intent} from '../widgets/common';
 import {Popup, PopupPosition} from '../widgets/popup';
 import {Omnibox} from './omnibox';
+import {SidebarItem} from './views/sidebar_item';
 
 class TraceErrorIcon implements m.ClassComponent<TraceImplAttrs> {
   private tracePopupErrorDismissed = false;
@@ -100,6 +101,44 @@ function renderSidePanelToggle(mgr: SidePanelManagerImpl): m.Children {
   });
 }
 
+function renderTopbarNavigation(app: AppImpl): m.Children {
+  if (app.embedder.navigationMode !== 'topbar') return undefined;
+  const logo = app.embedder.brandLogo;
+  const items = app.sidebar.menuItems
+    .valuesAsArray()
+    .filter(
+      (item) =>
+        item.topbar === true && (item.topbarPosition ?? 'left') === 'left',
+    )
+    .sort((a, b) => (a.sortOrder ?? 0) - (b.sortOrder ?? 0));
+  return m(
+    'nav.pf-topbar__navigation',
+    logo &&
+      m(
+        '.pf-topbar__brand',
+        m('img', {src: logo.src, alt: logo.alt}),
+      ),
+    m(
+      'ul.pf-topbar__navigation-actions',
+      items.map((item) => m(SidebarItem, {key: item.id, app, item})),
+    ),
+  );
+}
+
+function renderTopbarRightNavigation(app: AppImpl): m.Children {
+  if (app.embedder.navigationMode !== 'topbar') return undefined;
+  const items = app.sidebar.menuItems
+    .valuesAsArray()
+    .filter(
+      (item) => item.topbar === true && item.topbarPosition === 'right',
+    )
+    .sort((a, b) => (a.sortOrder ?? 0) - (b.sortOrder ?? 0));
+  return m(
+    'ul.pf-topbar__navigation-actions',
+    items.map((item) => m(SidebarItem, {key: item.id, app, item})),
+  );
+}
+
 export class Topbar implements m.ClassComponent<TopbarAttrs> {
   view({attrs}: m.Vnode<TopbarAttrs>) {
     const {trace} = attrs;
@@ -109,11 +148,15 @@ export class Topbar implements m.ClassComponent<TopbarAttrs> {
       {
         className: classNames(
           !app.sidebar.visible && 'pf-topbar--hide-sidebar',
+          app.embedder.navigationMode === 'topbar' &&
+            'pf-topbar--compact-navigation',
         ),
       },
+      renderTopbarNavigation(app),
       m(Omnibox, {trace}),
       m(
         '.pf-topbar__right',
+        renderTopbarRightNavigation(app),
         trace && m(TraceErrorIcon, {trace}),
         renderSidePanelToggle(app.sidePanel),
       ),
