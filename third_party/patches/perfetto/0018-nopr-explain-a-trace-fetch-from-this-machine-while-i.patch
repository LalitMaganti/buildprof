+import m from 'mithril';
+import {Icons} from '../base/semantic_icons';
+import {Callout} from '../widgets/callout';
+import {CodeSnippet} from '../widgets/code_snippet';
+import {Intent} from '../widgets/common';
+import {closeModal, showModal} from '../widgets/modal';
+
+// Dialogs for traces fetched from this machine, which is how the buildprof CLI
+// hands a trace to the UI. Chrome and Firefox gate those fetches behind a
+// permission prompted as "access other apps and services on this device": the
+// fetch hangs while the prompt is up, and once blocked it fails with a bare
+// "Failed to fetch". The site settings list it under different names.
+
+const PENDING_KEY = 'local_trace_fetch_pending';
+const PENDING_DELAY_MS = 500;
+
+const ALLOW_PROMPT_STEP =
+  'If Chrome asks to let this site "access other apps and services on this ' +
+  'device", allow it.';
+const SETTING_NAME = navigator.userAgent.includes('Firefox')
+  ? 'Access this device'
+  : 'Apps on device';
+const ALLOW_SETTING_STEP =
+  `Allow "${SETTING_NAME}" for this site in the site settings next to the ` +
+  'address bar.';
+const RETRY_STEP = 'Run buildprof open <TRACE> again.';
+
+function steps(...items: string[]): m.Children {
+  return m(
+    'div',
+    m('span.pf-error-dialog__list-label', 'What to do'),
+    m(
+      'ol.pf-error-dialog__list',
+      items.map((item) => m('li', item)),
+    ),
+  );
+}
+
+// Shows a dialog if the fetch of `url` is still pending after a short delay,
+// and closes it as soon as `fetching` settles. A fetch that Chrome already
+// allows completes well within the delay, so nothing flashes on screen.
+export async function withLocalTraceFetchDialog<T>(
+  url: string,
+  fetching: Promise<T>,
+): Promise<T> {
+  const timer = setTimeout(() => {
+    showModal({
+      key: PENDING_KEY,
+      title: 'Waiting for the trace from this machine',
+      content: () =>
+        m(
+          '.pf-error-dialog',
+          m(
+            Callout,
+            {icon: Icons.Info},
+            `This page is fetching the trace from ${url}, which the ` +
+              'buildprof command on this machine is serving.',
+          ),
+          steps(ALLOW_PROMPT_STEP),
+        ),
+    });
+  }, PENDING_DELAY_MS);
+  try {
+    return await fetching;
+  } finally {
+    clearTimeout(timer);
+    closeModal(PENDING_KEY);
+  }
+}
+
+async function appsOnDeviceDenied(): Promise<boolean> {
+  try {
+    const name = 'local-network-access' as PermissionName;
+    return (await navigator.permissions.query({name})).state === 'denied';
+  } catch {
+    return false;
+  }
+}
+
+export async function showLocalTraceFetchError(url: string, details: string) {
+  const denied = await appsOnDeviceDenied();
+  showModal({
+    title: denied
+      ? 'Chrome is blocking access to this machine'
+      : 'Could not fetch the trace from this machine',
+    content: () =>
+      m(
+        '.pf-error-dialog',
+        m(
+          Callout,
+          {icon: Icons.Warning, intent: Intent.Warning},
+          denied
+            ? `This site was denied the "${SETTING_NAME}" permission, which ` +
+                `is what lets the page fetch the trace from ${url}.`
+            : `Nothing answered at ${url}. The buildprof command serving ` +
+                'the trace may have stopped waiting, or Chrome may be ' +
+                'blocking this site from reaching this machine.',
+        ),
+        denied
+          ? steps(ALLOW_SETTING_STEP, RETRY_STEP)
+          : steps(RETRY_STEP, ALLOW_PROMPT_STEP, ALLOW_SETTING_STEP),
+        m(CodeSnippet, {
+          text: details,
+          language: 'Error details',
+          class: 'pf-error-dialog__code',
+        }),
+      ),
+  });
+}
